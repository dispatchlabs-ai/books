        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "schema": {
            "type": "string",
            "const": "books.api/v1"
          },
          "ok": {
            "const": false
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "schema",
          "ok",
          "error"
        ]
      },
      "Summary": {
        "type": "object",
        "properties": {
          "imported_transactions": {
            "type": "integer",
            "minimum": 0
          },
          "skipped_transactions": {
            "type": "integer",
            "minimum": 0
          },
          "new_journals": {
            "type": "integer",
            "minimum": 0
          },
          "existing_journals": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "imported_transactions",
          "skipped_transactions",
          "new_journals",
          "existing_journals"
        ]
      },
      "Classification": {
        "type": "object",
        "properties": {
          "transaction_id": {
            "type": "string"
          },
          "contra_account": {
            "type": "string"
          }
        },
        "required": [
          "transaction_id",
          "contra_account"
        ],
        "additionalProperties": false
      },
      "Mapping": {
        "type": "object",
        "properties": {
          "account_key": {
            "type": "string"
          },
          "statement_account": {
            "type": "string"
          },
          "classifications": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Classification"
            }
          }
        },
        "required": [
          "account_key",
          "statement_account"
        ],
        "additionalProperties": false
      },
      "Exclusion": {
        "type": "object",
        "properties": {
          "account_key": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
